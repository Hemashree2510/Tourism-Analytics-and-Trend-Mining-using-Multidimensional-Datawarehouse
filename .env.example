# Flask Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=tourismvista-academic-secret-key-2026

# Database Configuration
# Supported DB_TYPE options: 'mysql' or 'sqlite'
# If set to 'mysql', the app connects to MySQL. If connection fails or DB_TYPE='sqlite', it falls back to SQLite.
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tourism_warehouse

# Dataset Configuration
DATA_CSV_PATH=data/tourism_dataset.csv
SQLITE_DB_PATH=data/tourism_warehouse.db
